// Prisma schema for Violin Booking Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for authentication (admin and clients)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  role          String    @default("client") // admin, client
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  messages      Message[]
  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Event types configuration
model EventType {
  id              String    @id @default(cuid())
  name            String    // Wedding, Corporate, Private, Virtual
  slug            String    @unique
  description     String
  basePrice       Float
  minDuration     Int       // in minutes
  maxDuration     Int       // in minutes
  depositPercent  Float     @default(0.5) // 50% default deposit
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
  packages        Package[]
}

// Packages for each event type
model Package {
  id            String    @id @default(cuid())
  eventTypeId   String
  eventType     EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  name          String
  description   String
  price         Float
  duration      Int       // in minutes
  features      String    // JSON array of features
  isPopular     Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
}

// Main booking model
model Booking {
  id                String    @id @default(cuid())
  bookingNumber     String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  eventTypeId       String
  eventType         EventType @relation(fields: [eventTypeId], references: [id])
  packageId         String?
  package           Package?  @relation(fields: [packageId], references: [id])

  // Event details
  eventDate         DateTime
  startTime         String
  endTime           String
  duration          Int       // in minutes
  venueName         String
  venueAddress      String
  guestCount        Int?
  specialRequests   String?

  // Pricing
  basePrice         Float
  travelFee         Float     @default(0)
  addOns            String?   // JSON array of add-ons
  totalPrice        Float
  depositAmount     Float
  depositPaid       Boolean   @default(false)
  balancePaid       Boolean   @default(false)

  // Status
  status            String    @default("inquiry") // inquiry, deposit_pending, confirmed, completed, cancelled

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payments          Payment[]
  messages          Message[]
  songRequests      SongRequest[]
}

// Payment tracking
model Payment {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Float
  type            String   // deposit, balance, full
  status          String   @default("pending") // pending, completed, failed, refunded
  stripePaymentId String?
  stripeInvoiceId String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Client messages/communication
model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  content   String
  isAdmin   Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
}

// Song requests from clients
model SongRequest {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  songTitle String
  artist    String?
  notes     String?
  priority  Int      @default(0) // 0 = normal, 1 = must have, 2 = would be nice
  status    String   @default("pending") // pending, confirmed, not_available
  createdAt DateTime @default(now())
}

// Calendar availability/blocking
model Availability {
  id        String   @id @default(cuid())
  date      DateTime
  isBlocked Boolean  @default(false)
  reason    String?  // "booked", "personal", "travel"
  bookingId String?  // Reference to booking if blocked due to booking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}

// Repertoire/song list
model Repertoire {
  id          String   @id @default(cuid())
  title       String
  artist      String?
  genre       String   // Classical, Contemporary, Pop, Wedding, Jazz, Film
  category    String?  // Ceremony, Cocktail Hour, Reception, etc.
  duration    Int?     // in seconds
  isPopular   Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  audioUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Testimonials
model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  eventType   String
  venue       String?
  date        DateTime?
  content     String
  rating      Int      @default(5) // 1-5 stars
  isApproved  Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  photoUrl    String?
  createdAt   DateTime @default(now())
}

// Media gallery
model Media {
  id          String   @id @default(cuid())
  type        String   // photo, video, audio
  title       String
  description String?
  url         String
  thumbnailUrl String?
  category    String?  // Performance, Wedding, Corporate, etc.
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// Newsletter subscribers
model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  source       String?  // website, referral, event
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
}

// Inquiries/leads
model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  eventType   String?
  eventDate   DateTime?
  message     String
  status      String   @default("new") // new, contacted, qualified, converted, closed
  source      String?  // website, referral, advertisement
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pricing configuration
model PricingConfig {
  id          String   @id @default(cuid())
  name        String   @unique
  value       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// INTELLIGENT TRAVEL & SCHEDULING SYSTEM
// ============================================

// Home base locations (Nashville, Baltimore)
model HomeBase {
  id          String   @id @default(cuid())
  name        String   @unique // Nashville, Baltimore
  city        String
  state       String
  airport     String   // BNA, BWI
  airportName String
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       TravelItinerary[]
}

// Travel itinerary for each booking
model TravelItinerary {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  homeBaseId        String
  homeBase          HomeBase  @relation(fields: [homeBaseId], references: [id])

  // Venue info
  venueCity         String
  venueState        String
  venueAddress      String?
  venueLatitude     Float?
  venueLongitude    Float?
  distanceMiles     Float

  // Travel method
  travelMethod      String    // ground, flight

  // Departure
  departureDate     DateTime
  departureTime     String?

  // Return
  returnDate        DateTime
  returnTime        String?

  // Status
  status            String    @default("planned") // planned, booked, completed, cancelled

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  flights           FlightBooking[]
  hotels            HotelBooking[]
  expenses          TravelExpense[]
}

// Flight bookings
model FlightBooking {
  id              String          @id @default(cuid())
  itineraryId     String
  itinerary       TravelItinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  // Flight details
  type            String          // outbound, return
  airline         String?
  flightNumber    String?
  origin          String          // Airport code
  destination     String          // Airport code
  departureTime   DateTime
  arrivalTime     DateTime

  // Pricing
  estimatedPrice  Float
  actualPrice     Float?

  // Booking
  confirmationNum String?
  status          String          @default("pending") // pending, booked, checked_in, completed, cancelled

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Hotel bookings
model HotelBooking {
  id              String          @id @default(cuid())
  itineraryId     String
  itinerary       TravelItinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  // Hotel details
  hotelName       String?
  hotelAddress    String?
  hotelCity       String
  hotelState      String

  // Stay details
  checkInDate     DateTime
  checkOutDate    DateTime
  nights          Int

  // Pricing
  estimatedRate   Float           // Per night
  actualRate      Float?
  totalCost       Float?

  // Booking
  confirmationNum String?
  status          String          @default("pending") // pending, booked, checked_in, completed, cancelled

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Travel expenses tracking
model TravelExpense {
  id            String          @id @default(cuid())
  itineraryId   String
  itinerary     TravelItinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  category      String          // flight, hotel, ground, meals, parking, other
  description   String
  amount        Float
  isEstimate    Boolean         @default(true)
  receiptUrl    String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Calendar events for intelligent scheduling
model CalendarEvent {
  id              String    @id @default(cuid())
  title           String
  description     String?

  startDate       DateTime
  endDate         DateTime
  allDay          Boolean   @default(false)

  // Categorization
  category        String    // professional_booking, personal_block, travel_block, practice, rehearsal
  blockType       String    @default("hard") // hard, soft

  // Color for UI
  color           String?

  // Related booking (if professional)
  bookingId       String?

  // Travel relation (if travel block)
  relatedEventId  String?   // The event this travel is for
  travelType      String?   // departure, return

  // Auto-generated flags
  isAutoGenerated Boolean   @default(false)
  canOverride     Boolean   @default(false)

  // External calendar sync
  externalId      String?   // Google Calendar ID
  calendarSource  String?   // google, outlook, apple
  lastSyncedAt    DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Travel preferences
model TravelPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique

  // Airline preferences
  preferredAirlines   String?  // JSON array
  seatPreference      String   @default("aisle") // window, aisle, no_preference

  // Hotel preferences
  preferredHotelChains String? // JSON array
  minHotelRating      Int      @default(3) // 1-5 stars
  maxHotelDistance    Float    @default(5) // miles from venue

  // Ground transport
  mileageRate         Float    @default(0.67) // IRS rate

  // Pricing
  bufferPercentage    Float    @default(0.15) // 15%

  // Other
  requireNonStop      Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Flight price history for prediction
model FlightPriceHistory {
  id            String   @id @default(cuid())
  origin        String   // Airport code
  destination   String   // Airport code
  price         Float
  isNonStop     Boolean
  queryDate     DateTime // When we checked
  travelDate    DateTime // Date of travel
  daysOut       Int      // Days between query and travel

  createdAt     DateTime @default(now())

  @@index([origin, destination])
  @@index([travelDate])
}

// Hotel rate history for prediction
model HotelRateHistory {
  id            String   @id @default(cuid())
  city          String
  state         String
  rate          Float
  rating        Int      // Hotel star rating
  queryDate     DateTime
  stayDate      DateTime

  createdAt     DateTime @default(now())

  @@index([city, state])
  @@index([stayDate])
}

// ============================================
// SUBSCRIPTION & GIFT REVENUE SYSTEM
// ============================================

// Subscription Plans Configuration
model SubscriptionPlan {
  id              String   @id @default(cuid())
  type            String   // learning, recording_club, anniversary, hold_music
  tier            String   // foundation, professional, elite, monthly, annual, etc.
  name            String
  description     String
  price           Float    // Monthly price
  annualPrice     Float?   // Annual price (if applicable)
  features        String   // JSON array of features
  maxUsers        Int?     // For corporate plans
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subscriptions   Subscription[]

  @@unique([type, tier])
}

// Active Subscriptions
model Subscription {
  id                  String    @id @default(cuid())
  planId              String
  plan                SubscriptionPlan @relation(fields: [planId], references: [id])

  // Subscriber info
  email               String
  name                String
  phone               String?
  companyName         String?   // For corporate subscriptions

  // Billing
  billingCycle        String    @default("monthly") // monthly, annual
  currentPrice        Float
  stripeCustomerId    String?
  stripeSubscriptionId String?

  // Status
  status              String    @default("active") // active, paused, cancelled, past_due
  startDate           DateTime  @default(now())
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelledAt         DateTime?
  cancelReason        String?

  // Anniversary program specific
  weddingDate         DateTime? // For anniversary subscriptions
  partnerName         String?
  songTitle           String?   // "Our song"

  // Metadata
  referralSource      String?
  notes               String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  contentAccess       SubscriptionContentAccess[]
  payments            SubscriptionPayment[]
}

// Track content access for subscriptions
model SubscriptionContentAccess {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  contentId       String
  content         SubscriptionContent @relation(fields: [contentId], references: [id])
  accessedAt      DateTime     @default(now())
  completedAt     DateTime?
  progressPercent Int          @default(0)
}

// Subscription Content (lessons, recordings, etc.)
model SubscriptionContent {
  id              String    @id @default(cuid())
  type            String    // lesson, recording, resource, live_session
  subscriptionType String   // learning, recording_club
  tier            String    // foundation, professional, elite, all

  title           String
  description     String?
  thumbnailUrl    String?

  // Content details
  contentUrl      String?   // Video/audio URL
  duration        Int?      // In seconds
  sortOrder       Int       @default(0)

  // For lessons
  category        String?   // Beginner, Intermediate, Advanced, Technique, etc.

  // For recordings
  releaseMonth    String?   // e.g., "2024-01" for monthly releases

  isPublished     Boolean   @default(false)
  publishedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accessLogs      SubscriptionContentAccess[]
}

// Subscription Payments
model SubscriptionPayment {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount          Float
  status          String       @default("pending") // pending, completed, failed, refunded
  stripePaymentId String?
  stripeInvoiceId String?
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
}

// Gift Products Catalog
model GiftProduct {
  id              String    @id @default(cuid())
  type            String    // custom_arrangement, dedication_video, virtual_serenade, concert_box
  tier            String    // digital, keepsake, video, premium, standard, etc.
  name            String
  description     String
  price           Float
  rushPrice       Float?    // Additional cost for rush delivery
  features        String    // JSON array of what's included
  deliveryDays    Int       @default(7) // Standard delivery time
  rushDeliveryDays Int?     // Rush delivery time
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  imageUrl        String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders          GiftOrder[]
}

// Gift Orders
model GiftOrder {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  productId       String
  product         GiftProduct @relation(fields: [productId], references: [id])

  // Customer info (purchaser)
  customerEmail   String
  customerName    String
  customerPhone   String?

  // Recipient info
  recipientName   String
  recipientEmail  String?
  recipientPhone  String?

  // Order details
  occasion        String?     // birthday, anniversary, sympathy, etc.
  dedicationMessage String?   // Personal message to include
  songRequest     String?     // Requested song
  songArtist      String?
  additionalNotes String?

  // Scheduling (for virtual serenades)
  scheduledDate   DateTime?
  scheduledTime   String?
  timezone        String?

  // Pricing
  basePrice       Float
  rushFee         Float       @default(0)
  totalPrice      Float

  // Delivery
  isRush          Boolean     @default(false)
  dueDate         DateTime
  deliveredAt     DateTime?
  deliveryUrl     String?     // Download link for digital products

  // Status
  status          String      @default("pending") // pending, in_progress, ready, delivered, cancelled

  // Payment
  stripePaymentId String?
  paidAt          DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Sheet Music Products
model SheetMusic {
  id              String    @id @default(cuid())
  title           String
  artist          String?
  arranger        String    @default("Victoria Strings")

  // Categorization
  category        String    // wedding, pop, film, holiday, classical
  difficulty      String?   // beginner, intermediate, advanced

  // Product details
  description     String?
  price           Float
  previewUrl      String?   // Preview image or audio
  downloadUrl     String    // PDF download URL
  pageCount       Int?
  duration        String?   // e.g., "3:45"

  // Bundle info
  bundleId        String?   // If part of a bundle

  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchases       SheetMusicPurchase[]
}

// Sheet Music Purchases
model SheetMusicPurchase {
  id              String     @id @default(cuid())
  sheetMusicId    String
  sheetMusic      SheetMusic @relation(fields: [sheetMusicId], references: [id])

  customerEmail   String
  customerName    String?

  price           Float
  stripePaymentId String?

  downloadCount   Int        @default(0)
  lastDownloadAt  DateTime?

  createdAt       DateTime   @default(now())
}

// Sheet Music Bundles
model SheetMusicBundle {
  id              String    @id @default(cuid())
  name            String    // e.g., "Complete Wedding Package"
  description     String
  category        String    // wedding, holiday, etc.
  price           Float
  originalValue   Float     // Sum of individual prices
  sheetMusicIds   String    // JSON array of included sheet music IDs
  imageUrl        String?
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Gift Cards
model GiftCard {
  id              String    @id @default(cuid())
  code            String    @unique

  // Purchaser info
  purchaserEmail  String
  purchaserName   String

  // Recipient info
  recipientEmail  String?
  recipientName   String?
  personalMessage String?

  // Value
  originalAmount  Float
  currentBalance  Float

  // Delivery
  deliveryType    String    @default("digital") // digital, physical
  deliveredAt     DateTime?

  // Status
  status          String    @default("active") // active, redeemed, expired, cancelled
  expiresAt       DateTime? // Null = no expiration

  // Payment
  stripePaymentId String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  redemptions     GiftCardRedemption[]
}

// Gift Card Redemptions
model GiftCardRedemption {
  id          String   @id @default(cuid())
  giftCardId  String
  giftCard    GiftCard @relation(fields: [giftCardId], references: [id])
  amount      Float
  orderId     String?  // Reference to what was purchased
  orderType   String?  // booking, gift_product, subscription, sheet_music
  redeemedBy  String   // Email of person who redeemed
  createdAt   DateTime @default(now())
}

// Product Reviews (for gift products and sheet music)
model ProductReview {
  id          String   @id @default(cuid())
  productType String   // gift_product, sheet_music
  productId   String

  reviewerName  String
  reviewerEmail String
  rating        Int      // 1-5
  title         String?
  content       String

  isVerified    Boolean  @default(false) // Verified purchase
  isApproved    Boolean  @default(false)

  createdAt     DateTime @default(now())
}

// Cross-sell tracking
model CrossSellConversion {
  id              String   @id @default(cuid())
  sourceType      String   // booking, gift_product, subscription
  sourceId        String
  targetType      String   // subscription, gift_product, sheet_music
  targetId        String
  conversionDate  DateTime @default(now())
  revenue         Float
}
